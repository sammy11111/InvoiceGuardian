          "confidence_expectation": "ABSTAIN",
          "evidence": [
            {
              "kind": "supporting_quote",
              "document_id": "SOW-2026-03",
              "section": "2",
              "page": 1,
              "quote": "Northbridge shall provide implementation support for Maplecore's ERP rollout, data migration validation, and training documentation."
            },
            {
              "kind": "invoice_line",
              "document_id": "INV-2026-064",
              "line_id": "L1"
            }
          ],
          "scoring_note": "ESCALATE is the only correct disposition. AUTO_EXCEPTION or SEMANTIC_EXCEPTION here = incorrect_confident. CLEAN here = miss.",
          "rationale": "The description is plausibly related to the authorized scope but insufficiently specified: it may overlap with implementation support or may represent advisory services outside the SOW. The supplied documents are insufficient to resolve the distinction; escalation is the only defensible disposition."
